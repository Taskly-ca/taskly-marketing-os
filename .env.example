# TMOS environment. Copy to .env and fill. NEVER commit real values.

NODE_ENV=development

# Database (a SEPARATE Supabase project from the marketplace — no shared blast radius)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres, for @tmos/db. Required — the client NEVER falls back to localhost.
# Supabase gives you this under Project Settings → Database → Connection string.
# HOST: use the SESSION POOLER (aws-0-ca-central-1.pooler.supabase.com:5432), not
# db.hakstgvubyirdxchhatx.supabase.co. The direct host resolves to AAAA only and this
# machine has no IPv6 route, so the direct URI cannot connect at all. Supavisor
# usernames are `<role>.<project-ref>`. Port 5432 is session mode — required,
# because the adapters use `begin read only` and `set local`.
DATABASE_URL=

# ── The analytical escape hatch runs as a SEPARATE, UNPRIVILEGED role ───────
# `runAnalyticalQuery` executes SQL that a resolver spec or an agent supplied,
# so the keyword blocklist is defence in depth and the ROLE is the boundary.
# It must never reuse DATABASE_URL: on Supabase `postgres` is not a superuser
# but does hold rolbypassrls + rolcreaterole and INHERITS tmos_analyst, so a
# membership test alone would wave it straight through — the adapter probes
# those attributes and refuses. Note 006's role settings apply at LOGIN and are
# NOT inherited through SET ROLE, which is why a login member exists at all.
# ── Migrations run as the DATABASE OWNER, never as the app role ─────────────
# `pnpm --filter @tmos/worker migrate` needs CREATE on schema public, and the
# app role does not have it: migration 011 leaves `tmos_app_login` with USAGE
# only, so a process that reads competitor pages all day cannot create a table.
# This is the `postgres` connection string from Project Settings -> Database
# (session pooler, port 5432). No fallback to DATABASE_URL: granting the app
# role CREATE to avoid setting this would undo 011 permanently.
DATABASE_MIGRATOR_URL=

DATABASE_ANALYST_URL=
DATABASE_ANALYST_POOL_MAX=2
# Optional. Defaults: pool max 10, statement timeout 15000ms.
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# LLM — at least one required. Both already exist in the marketplace repo.
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Delivery: how the digest reaches a human ────────────────────────────────
# Whichever pair is complete is used, Slack first. Neither set is a REPORTED
# skip, never a crash — a run that collected and reasoned correctly did not fail
# because nobody set a token. Half a pair does not count as configured.
#
# Slack: a bot token with chat:write, plus the channel id (not the name).
SLACK_BOT_TOKEN=
SLACK_DIGEST_CHANNEL=
# Email fallback: no interaction controls, because an email cannot carry a
# dismiss-with-a-reason select and buttons that do nothing are worse than none.
RESEND_API_KEY=
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=
# Where a reader lands from a digest link. Defaults to a file:// URL for the
# generated briefing — a link that opens a page someone can read beats a link
# to a server nobody has deployed.
TMOS_DEEP_LINK_BASE=

# ── Budget ceilings — ENFORCED in shared/llm, not advisory ──────────────────
# Defaults are deliberately small: a misconfiguration should cost pennies.
TMOS_MAX_RUN_TOKENS=100000
TMOS_MAX_DAILY_COST_CENTS=2000
TMOS_MAX_TOOL_DEPTH=8
TMOS_KILLSWITCH=false

# ── Free-tier collectors (Part 2) — absent creds skip the source, never fail ─
# Product Hunt: developer token, free tier.
PRODUCT_HUNT_TOKEN=
# Search Console: a raw OAuth access token expires in ~1h and NOTHING refreshes
# it yet. A 401 is deliberately non-retryable so an expired token surfaces as an
# alert rather than a retry storm — but refresh must be owned before this is
# put on a schedule.
GSC_ACCESS_TOKEN=
# Either `sc-domain:taskly.ca` or `https://taskly.ca/` — both are legal site ids.
GSC_SITE_URL=

# ── Not yet provisioned (gate Part 8) ───────────────────────────────────────
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
# EXA_API_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# AYRSHARE_API_KEY=

# ── The FACT-SHEET the adversarial verifier checks claims against ───────────
# `taskly-brain/00-brain/FACT-SHEET.md` in the marketplace repo — generated by
# `npm run brain:facts` from the constants in the code, with a CI gate that
# fails when it goes stale. There is deliberately NO default path: a guessed one
# that is wrong on a deploy fails in the way the sheet exists to prevent, with
# a gate that still reports passing. Unset means the verifier refuses to run.
TASKLY_FACT_SHEET=/absolute/path/to/taskly.ca/taskly-brain/00-brain/FACT-SHEET.md

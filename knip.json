{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs"
      ],
      "project": [
        "scripts/**"
      ]
    },
    "packages/*": {
      "project": [
        "src/**"
      ]
    },
    "apps/*": {
      "project": [
        "src/**"
      ]
    },
    "apps/worker": {
      "entry": [
        "src/seed/run.ts"
      ]
    }
  }
}

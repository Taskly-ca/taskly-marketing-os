{
  "name": "taskly-marketing-os",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check:migrations": "node scripts/check-migrations.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm knip && pnpm check:migrations",
    "test:live": "vitest run --config vitest.live.config.ts",
    "console": "pnpm --filter @tmos/console build && pnpm --filter @tmos/console start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "knip": "^5.66.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}

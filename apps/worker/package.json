{
  "name": "@tmos/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "ingest": "node --env-file-if-exists=../../.env dist/cli.js",
    "run:pass": "node --env-file-if-exists=../../.env dist/run.js",
    "migrate": "node --env-file-if-exists=../../.env dist/migrate.js",
    "seed:predictions": "node --env-file-if-exists=../../.env dist/seed/run.js",
    "resolve": "node --env-file-if-exists=../../.env dist/resolve.js",
    "cascade": "node --env-file-if-exists=../../.env dist/cascade.js",
    "digest": "node --env-file-if-exists=../../.env dist/digest.js",
    "watch": "node --env-file-if-exists=../../.env dist/watch.js",
    "report": "node --env-file-if-exists=../../.env dist/report.js",
    "brain:sync": "node --env-file-if-exists=../../.env dist/brain-sync.js",
    "forecast": "node --env-file-if-exists=../../.env dist/forecast.js"
  },
  "dependencies": {
    "@tmos/adapters": "workspace:*",
    "@tmos/brain": "workspace:*",
    "@tmos/collectors": "workspace:*",
    "@tmos/contracts": "workspace:*",
    "@tmos/db": "workspace:*",
    "@tmos/gate": "workspace:*",
    "@tmos/guardrails": "workspace:*",
    "@tmos/intel": "workspace:*",
    "@tmos/packs": "workspace:*",
    "@tmos/reason": "workspace:*",
    "@tmos/shared": "workspace:*",
    "@tmos/surface": "workspace:*",
    "@tmos/world": "workspace:*"
  }
}

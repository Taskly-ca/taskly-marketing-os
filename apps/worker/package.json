{
  "name": "@tmos/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "ingest": "node --env-file-if-exists=../../.env dist/cli.js",
    "seed:predictions": "node --env-file-if-exists=../../.env dist/seed/run.js"
  },
  "dependencies": {
    "@tmos/adapters": "workspace:*",
    "@tmos/collectors": "workspace:*",
    "@tmos/contracts": "workspace:*",
    "@tmos/db": "workspace:*",
    "@tmos/gate": "workspace:*",
    "@tmos/intel": "workspace:*",
    "@tmos/shared": "workspace:*"
  }
}
